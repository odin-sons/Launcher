<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Odinsons.ValheimLauncher.Avalonia.App"
             Name="Odinsons Launcher"
             RequestedThemeVariant="Dark">
    <Application.Resources>
        <x:String x:Key="ProductName">Odinsons Launcher</x:String>
        <x:String x:Key="ProductByline">by OdinSons</x:String>
    </Application.Resources>
    <Application.Styles>
        <FluentTheme />
    </Application.Styles>
</Application>
