<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="Odinsons.ValheimLauncher.Avalonia.Views.ServerSelectionWindow"
        Width="300" Height="200"
        CanResize="False"
        WindowStartupLocation="CenterScreen"
        WindowDecorations="None"
        Background="Transparent"
        FontFamily="avares://OdinsonsLauncher/Resources/Fonts#Montserrat"
        FontWeight="Medium">
    <Border Background="#FF2D2D2D" BorderBrush="Chocolate" BorderThickness="2">
        <Grid RowDefinitions="Auto,*,Auto">
            <!-- Header -->
            <TextBlock x:Name="HeaderText" Grid.Row="0" FontSize="16" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,10,0,10"/>

            <!-- Server picker -->
            <ComboBox x:Name="ServerComboBox" Grid.Row="1" Width="200" Height="30"
                      Margin="0,0,0,20" FontSize="14" SelectionChanged="ServerComboBox_SelectionChanged"/>

            <!-- Confirm button -->
            <Button x:Name="ConfirmButton" Grid.Row="2" Width="80" Height="30"
                    Margin="0,0,0,20" Click="ConfirmButton_Click"
                    Background="Chocolate" Foreground="White" FontSize="14"
                    CornerRadius="5" IsEnabled="False"
                    HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/>
        </Grid>
    </Border>
</Window>
