<Window
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:av="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    xmlns:local="clr-namespace:Odinsons.ValheimLauncher"
    mc:Ignorable="av"
    x:Class="Odinsons.ValheimLauncher.MainWindow"
    Title="OdinsonsLauncher"
    Height="610"
    Width="900"
    Cursor="Arrow"
    ResizeMode="NoResize"
    WindowStartupLocation="CenterScreen"
    WindowStyle="None"
    AllowsTransparency="True"
    Background="Transparent"
    Opacity="1"
    Icon="Resources/favicon.ico">

    <!-- Window resources -->
    <Window.Resources>
        <!-- Converter to invert IsEnabled -->
        <local:InverseBooleanConverter x:Key="InverseBooleanConverter" />
        <local:MultiplyConverter x:Key="MultiplyConverter" />
        <!-- Converter for bool to Visibility -->
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

        <!-- Style for the server-selection ComboBox -->
        <Style x:Key="CustomComboBoxStyle" TargetType="{x:Type ComboBox}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="FontFamily" Value="Sitka Text"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="160"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="Padding" Value="5"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBox}">
                        <Grid>
                            <!-- Button to open/close the dropdown -->
                            <ToggleButton x:Name="ToggleButton"
                                          Focusable="False"
                                          IsChecked="{Binding Path=IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                          ClickMode="Press">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="MainBorder"
                                                Background="#80373737" 
                                                CornerRadius="5"
                                                SnapsToDevicePixels="True">
                                            <Grid>
                                                <!-- Arrow -->
                                                <Path x:Name="Arrow"
                                                      Data="M 0 0 L 4 4 L 8 0 Z"
                                                      Fill="#FFFFFF"
                                                      HorizontalAlignment="Right"
                                                      VerticalAlignment="Center"
                                                      Width="8"
                                                      Height="4"
                                                      Margin="0,0,5,0"/>
                                            </Grid>
                                        </Border>

                                        <ControlTemplate.Triggers>
                                            <!-- Hover effect -->
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="MainBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFFFFF" ShadowDepth="0" BlurRadius="10" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <!-- Effect while the dropdown is open -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter TargetName="Arrow" Property="RenderTransform">
                                                    <Setter.Value>
                                                        <RotateTransform Angle="180" CenterX="4" CenterY="2"/>
                                                    </Setter.Value>
                                                </Setter>
                                                <Setter TargetName="MainBorder" Property="Effect">
                                                    <Setter.Value>
                                                        <DropShadowEffect Color="#FFFFFF" ShadowDepth="0" BlurRadius="10" Opacity="0.8"/>
                                                    </Setter.Value>
                                                </Setter>
                                            </Trigger>
                                            <!-- Disabled state -->
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter TargetName="MainBorder" Property="Opacity" Value="0.4"/>
                                                <Setter TargetName="Arrow" Property="Fill" Value="Gray"/>
                                                <Setter TargetName="Arrow" Property="Visibility" Value="Collapsed"/>
                                                <Setter Property="Foreground" Value="Gray"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!-- Display of the selected item -->
                            <ContentPresenter x:Name="ContentSite"
                                              Content="{TemplateBinding SelectionBoxItem}"
                                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"
                                              Margin="10,0,20,0"/>

                            <!-- Dropdown list -->
                            <Popup x:Name="PART_Popup"
                                   Placement="Bottom"
                                   IsOpen="{TemplateBinding IsDropDownOpen}"
                                   AllowsTransparency="True"
                                   PopupAnimation="Fade"
                                   Focusable="False">
                                <Border x:Name="DropDownBorder"
                                        Background="#80373737"
                                        CornerRadius="5"
                                        MinWidth="{TemplateBinding ActualWidth}"
                                        MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                    <ScrollViewer SnapsToDevicePixels="True"
                                                  Padding="0,5,0,5">
                                        <StackPanel IsItemsHost="True" Margin="0,0,0,5"/>
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style for the item display (ComboBoxItem) -->
        <Style x:Key="CustomComboBoxItemStyle" TargetType="{x:Type ComboBoxItem}">
            <Setter Property="Foreground" Value="#FFFFFF"/>
            <Setter Property="Background" Value="#80373737"/>          
            <Setter Property="Padding" Value="10,5"/>
            <Setter Property="SnapsToDevicePixels" Value="True"/>
            <Setter Property="MinHeight" Value="30"/>
            <Setter Property="Height" Value="34"/>
            <Setter Property="Width" Value="170"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ComboBoxItem}">
                        <Border x:Name="ItemBorder"
                                Background="{TemplateBinding Background}" 
                                CornerRadius="5"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <!-- Item text display -->
                                <ContentPresenter HorizontalAlignment="Left"
                                                  VerticalAlignment="Center"
                                                  Content="{TemplateBinding Content}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!-- Mouse hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFFF"
                                                          ShadowDepth="0"
                                                          BlurRadius="10"
                                                          Opacity="0.8"/>   <!-- slightly brighter, like the ToggleButton -->
                                    </Setter.Value>
                                </Setter>
                            </Trigger>

                            <!-- Selected item -->
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Effect">
                                    <Setter.Value>
                                        <DropShadowEffect Color="#FFFFFF"
                                                          ShadowDepth="0"
                                                          BlurRadius="15"
                                                          Opacity="1"/>     <!-- brightest glow -->
                                    </Setter.Value>
                                </Setter>
                                <!-- Could lighten the background slightly on selection, if wanted -->
                                <!-- <Setter TargetName="ItemBorder" Property="Background" Value="#A0333737"/> -->
                            </Trigger>

                            <!-- Disabled state -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="Gray"/>
                                <Setter TargetName="ItemBorder" Property="Opacity" Value="0.4"/>
                            </Trigger>

                            <!-- Optional: keyboard-focus highlight (if needed) -->
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#FFFFFF"/>
                                <Setter TargetName="ItemBorder" Property="BorderThickness" Value="1"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        
        <!-- Style for the progress bar -->
        <Style x:Key="ImageFill" TargetType="{x:Type ProgressBar}">
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ProgressBar}">
                        <Grid x:Name="TemplateRoot" SnapsToDevicePixels="true">
                            <Image x:Name="PART_Track" Source="Resources/test_progressbar.png" Margin="1" Stretch="Fill"/>
                            <Image Source="Resources/test_progressbar_green.png" Margin="1" Stretch="Fill" Width="{TemplateBinding Value}" HorizontalAlignment="Left" Opacity="1"/>
                            <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="2"/>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        

        
    </Window.Resources>

    <!-- Main container -->
    <Grid Margin="0,0,0,0"
          MouseDown="Grid_MouseDown"
          MouseMove="Grid_MouseMove"
          MouseUp="Grid_MouseUp">
        <Grid.Background>
            <ImageBrush ImageSource="/Resources/background.png"/>
        </Grid.Background>
        
        
        <!-- Button panel background -->
        <Border x:Name="mainButtons" 
                Width="334"
                Height="540"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Margin="10,10,0,0"
                CornerRadius="20">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                    <GradientStop Offset="0" Color="#06151515"/>
                    <GradientStop Offset="0" Color="#80373737"/>
                </LinearGradientBrush>
            </Border.Background>
            <Border.OpacityMask>
                <VisualBrush>
                    <VisualBrush.Visual>
                        <Border 
                            Background="Black" 
                            CornerRadius="{Binding CornerRadius, ElementName=mainButtons}"
                            Width="{Binding ActualWidth, ElementName=mainButtons}"
                            Height="{Binding ActualHeight, ElementName=mainButtons}"
                            SnapsToDevicePixels="True"/>
                    </VisualBrush.Visual>
                </VisualBrush>
            </Border.OpacityMask>
        </Border>
        
        <!-- Logo -->
        <Image Source="/Resources/logo.png"
               Width="298"
               Height="81"
               VerticalAlignment="Top"
               HorizontalAlignment="Left"
               Margin="28,27,0,0"/>
        
        <!-- Discord button -->
        <Button x:Name="Discord"
                Width="176"
                Height="52"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="89,153,0,0"
                Click="DiscordButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/discord_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/discord.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Telegram button -->
        <Button x:Name="Telegram"
                Width="176"
                Height="52"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="89,235,0,0"
                Click="TelegramButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/telegram_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/telegram.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Website button -->
        <Button x:Name="Website"
                Width="176"
                Height="52"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="89,317,0,0"
                Click="WebsiteButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/website_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/website.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Donate button -->
        <Button x:Name="Donate"
                Width="176"
                Height="52"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="89,399,0,0"
                Click="DonateButton_Click">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/donate_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/donate.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        <!-- Start button -->
        <Grid Name="StartButtonGrid">
            <Button x:Name="StartGameBtn"
                    Width="226"
                    Height="64"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="64,480,0,0"
                    Click="StartGameBtn_Click"
                    IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, RelativeSource={RelativeSource AncestorType=Window}}">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel>
                            <Image x:Name="Close2" Source="Resources/start_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                            <Image x:Name="Close1" Source="Resources/start.png" Stretch="Fill" Visibility="Visible"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid>
        
        <!-- Top panel -->

            <!-- Server status indicator -->
                <Ellipse x:Name="ServerStatusIndicator"
                         Width="10"
                         Height="10"
                         Fill="Red"
                         HorizontalAlignment="Left"
                         VerticalAlignment="Top"
                         Margin="384,22,0,0"/>

                <!-- Custom ComboBox for server selection -->
                <ComboBox x:Name="ServerSelector"
                          Style="{StaticResource CustomComboBoxStyle}"
                          ItemContainerStyle="{StaticResource CustomComboBoxItemStyle}"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Top"
                          Margin="403,10,0,0"
                          SelectionChanged="ServerSelector_SelectionChanged"
                          Focusable="True"
                          IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, RelativeSource={RelativeSource AncestorType=Window}}"/>

                <!-- Player count -->
                <TextBlock x:Name="PlayerCountText"
                           Text="Vikings: 0"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Width="170"
                           Height="34"
                           Margin="583,17,0,0"
                           FontSize="16"
                           FontFamily="Sitka Text"
                           Foreground="#FFFFFF"
                           MouseEnter="PlayerCountText_MouseEnter"
                           MouseLeave="PlayerCountText_MouseLeave" />

                <!-- Popup for the player list -->
                <Popup x:Name="PlayersPopup"
                       Placement="Bottom"
                       PlacementTarget="{Binding ElementName=PlayerCountText}"
                       AllowsTransparency="True"
                       PopupAnimation="Fade"
                       StaysOpen="False"
                       Opened="PlayersPopup_Opened"
                       Closed="PlayersPopup_Closed">
                    <Border Background="#CC000000"
                            BorderBrush="Transparent"
                            BorderThickness="0"
                            CornerRadius="5"
                            Padding="10"
                            MouseEnter="PlayersPopup_MouseEnter"
                            MouseLeave="PlayersPopup_MouseLeave">
                        <ScrollViewer MaxHeight="400"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Disabled">
                            <StackPanel x:Name="PlayersListPanel" />
                        </ScrollViewer>
                    </Border>
                </Popup>
        <!-- Changelog button -->
        <Button x:Name="ChangelogButton"
                HorizontalAlignment="Left"
                Margin="799,17,0,0"
                VerticalAlignment="Top"
                Width="20"
                Height="20"
                Click="ChangelogButton_Click"
                Panel.ZIndex="10">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/settings_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/settings.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Changelog panel -->
        <Grid Name="ChangelogGrid" 
              Visibility="Collapsed"
              Panel.ZIndex="1000">
            <!-- Dark semi-transparent background -->
            <Rectangle Fill="#E6000000" 
                       Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}}"
                       Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}}"/>

            <!-- Changelog list -->
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.90}"
                          Height="{Binding ActualHeight, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource MultiplyConverter}, ConverterParameter=0.85}"
                          Margin="22,20,22,60"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Center">
                <StackPanel x:Name="ChangelogContent"
                            Margin="30,40,30,60"
                            VerticalAlignment="Top"
                            HorizontalAlignment="Left">
                    <!-- Content is populated dynamically -->
                </StackPanel>
            </ScrollViewer>

            <!-- Changelog close button -->
            <Button x:Name="CloseChangelogButton"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="20"
                    Height="20"
                    Margin="0,35,27,0"
                    Click="CloseChangelogButton_Click">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel>
                            <Image x:Name="Close2" Source="Resources/close_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                            <Image x:Name="Close1" Source="Resources/close.png" Stretch="Fill" Visibility="Visible"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </Grid> 
        
        <!-- Minimize button -->
        <Button x:Name="minimize_btn"
                Height="4"
                Width="24"
                Margin="834,34,0,0"
                VerticalAlignment="Top"
                HorizontalAlignment="Left"
                Click="Minimize">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/minimaze_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/minimaze.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
        </Button>
        
        <!-- Close button -->
            <Button x:Name="button"
                    Margin="872,18,10,0"
                    VerticalAlignment="Top"
                    Height="20"
                    BorderThickness="0"
                    HorizontalAlignment="Left"
                    Width="20"
                    IsHitTestVisible="True"
                    Cursor="Hand"
                    PreviewMouseLeftButtonUp="Button_Close">
                <Button.Template>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <StackPanel>
                            <Image x:Name="Close2" Source="Resources/close_hover.png" Stretch="Fill" Visibility="Collapsed"/>
                            <Image x:Name="Close1" Source="Resources/close.png" Stretch="Fill" Visibility="Visible"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        
        
        
        <!-- News block -->
        <Grid Name="NewsGrid">
            <!-- News background -->
            <Border x:Name="NewsBackground" 
                    Width="489"
                    Height="390"
                    VerticalAlignment="Top"
                    HorizontalAlignment="Left"
                    Margin="384,153,0,0"
                    CornerRadius="20">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                        <GradientStop Offset="0" Color="#06151515"/>
                        <GradientStop Offset="0" Color="#80373737"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Border.OpacityMask>
                    <VisualBrush>
                        <VisualBrush.Visual>
                            <Border 
                                Background="Black" 
                                CornerRadius="{Binding CornerRadius, ElementName=mainButtons}"
                                Width="{Binding ActualWidth, ElementName=mainButtons}"
                                Height="{Binding ActualHeight, ElementName=mainButtons}"
                                SnapsToDevicePixels="True"/>
                        </VisualBrush.Visual>
                    </VisualBrush>
                </Border.OpacityMask>
            </Border>
            <!-- News -->
            <ScrollViewer 
                Width="452"
                Height="365"
                VerticalScrollBarVisibility="Auto"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                HorizontalScrollBarVisibility="Disabled"
                Margin="402,170,0,0">
                <TextBlock Name="News"
                           TextWrapping="Wrap"
                           Margin="1,1,1,1"
                           FontStyle="Normal"
                           FontWeight="Normal"
                           FontSize="16"
                           Foreground="White"
                           FontFamily="Sitka Text"/>
            </ScrollViewer>
        </Grid>
        
        <!-- Launcher version -->
        <Grid x:Name="VersionForm"
              VerticalAlignment="Top"
              HorizontalAlignment="Left">
            <TextBlock x:Name="CopyrightText"
                       Width="245"
                       Height="13"
                       Margin="599,589,0,0"
                       FontSize="12"
                       FontFamily="Microsoft New Tai Lue"
                       Foreground="#FFFFFF"
                       TextAlignment="Left"/>
        </Grid>
        <Grid x:Name="VersionForm2"
              VerticalAlignment="Top"
              HorizontalAlignment="Left">
            <TextBlock x:Name="VersionText"
                       Width="35"
                       Height="13"
                       Margin="839,589,0,0"
                       FontSize="12"
                       FontFamily="Microsoft New Tai Lue"
                       Foreground="#FFFFFF"
                       TextAlignment="Left">
                <Run>____</Run>
            </TextBlock>
        </Grid>
        <!-- Progress bar panel -->
        <Grid Name="ProgressBarGrid"
              Width="900"
              Height="60"
              VerticalAlignment="Bottom"
              HorizontalAlignment="Right"
              Margin="0,0,0,10">
            <Grid Name="ProgressBarGridMin"
                  Width="750"
                  Height="50"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Right"
                  Margin="0,0,10,10">
                <ProgressBar x:Name="progressbar"
                             Value="0"
                             Maximum="{Binding Width, ElementName=ProgressBarGridMin}"
                             Height="8"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,5,20"
                             Style="{StaticResource ImageFill}"/>
                <ProgressBar x:Name="progressbartotal"
                             Value="0"
                             Maximum="{Binding Width, ElementName=ProgressBarGridMin}"
                             Height="8"
                             VerticalAlignment="Bottom"
                             HorizontalAlignment="Stretch"
                             Margin="0,0,5,5"
                             Style="{StaticResource ImageFill}"/>
                <TextBlock x:Name="currenttask"
                           HorizontalAlignment="Stretch"
                           Margin="0,0,0,38"
                           TextAlignment="Left"
                           VerticalAlignment="Bottom"
                           Foreground="White"
                           FontSize="12"
                           FontStyle="Oblique"
                           TextWrapping="Wrap"/>
            </Grid>
            <Grid Width="120"
                  Height="50"
                  VerticalAlignment="Bottom"
                  HorizontalAlignment="Left"
                  Margin="10,0,0,10">
                <Label x:Name="totalpercent"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Margin="0,0,0,15"
                       VerticalAlignment="Bottom"
                       FontSize="20"
                       Foreground="#FFE6E6E6"
                       FontFamily="Verdana"
                       FontWeight="Bold"/>
                <Label x:Name="totalpercenttext"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Center"
                       Margin="0,0,0,-2"
                       VerticalAlignment="Bottom"
                       FontSize="12"
                       Foreground="#FFE6E6E6"/>
            </Grid>
        </Grid>
        
        
        
        <!-- Full check button -->
        <Button x:Name="FullCheck"
                HorizontalAlignment="Left"
                Margin="768,18,0,0"
                VerticalAlignment="Top"
                Width="20"
                Height="20"
                Click="StartGameBtn_Click_Full"
                IsEnabled="{Binding IsLoading, Converter={StaticResource InverseBooleanConverter}, RelativeSource={RelativeSource AncestorType=Window}}">
            <Button.Template>
                <ControlTemplate TargetType="{x:Type Button}">
                    <StackPanel>
                        <Image x:Name="Close2" Source="Resources/service_green.png" Stretch="Fill" Visibility="Collapsed"/>
                        <Image x:Name="Close1" Source="Resources/service.png" Stretch="Fill" Visibility="Visible"/>
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Close2" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="Close1" Property="Visibility" Value="Collapsed"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Button.Template>
            <Popup AllowsTransparency="True"
                   VerticalOffset="2"
                   HorizontalOffset="2"
                   IsOpen="{Binding IsMouseOver, ElementName=Boosty, Mode=OneWay}"
                   PlacementTarget="{Binding ElementName=Boosty}"
                   Placement="Top">
                <TextBlock x:Name="FullCheckTooltipText" Foreground="Azure"/>
            </Popup>
        </Button>
        
        
    </Grid>
</Window>