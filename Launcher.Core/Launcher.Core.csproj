<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net9.0</TargetFramework>
        <RootNamespace>Odinsons.ValheimLauncher</RootNamespace>
        <AssemblyName>Launcher.Core</AssemblyName>
        <LangVersion>latest</LangVersion>

        <!-- A throwaway key of its own, not the WPF launcher's production key — this assembly
             just needs SOME strong name to avoid CS8002 when the signed WPF launcher
             references it; nothing here relies on it matching the launcher's actual key. -->
        <SignAssembly>true</SignAssembly>
        <AssemblyOriginatorKeyFile>CloudBuild.snk</AssemblyOriginatorKeyFile>
    </PropertyGroup>

</Project>
